# ==============================================================================
# Cliplift Environment Variables
# Copy to .env and fill in. All values are OPTIONAL — missing keys trigger mock
# fallbacks so the full stack runs end-to-end without any external services.
# ==============================================================================

# --- Application ---
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_NAME=Cliplift
API_V1_PREFIX=/api/v1

# --- Backend (FastAPI) ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# Comma-separated origins for CORS. Frontend dev server + production domain.
CORS_ORIGINS=http://localhost:3000,https://cliplift.com

# --- Database (Supabase Postgres) ---
# When running `npx supabase start`, use the local connection string it prints.
# Default local: postgresql+asyncpg://postgres:postgres@127.0.0.1:54322/postgres
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:54322/postgres

# --- Supabase Auth ---
# `npx supabase start` prints these. Cloud project: Settings → API.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# JWT secret for verifying Supabase tokens (Settings → API → JWT Secret)
SUPABASE_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long

# --- Upstash (Redis + QStash) ---
# Leave empty to use local in-memory rate-limiting fallback
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# --- Data Providers (all optional, mock fallback when empty) ---
# YouTube Data API v3 — free, get from Google Cloud Console
YOUTUBE_API_KEY=

# Netrows API — LinkedIn data, €49/mo
NETROWS_API_KEY=

# Data365 API — TikTok + Instagram data, $99/mo
DATA365_API_KEY=

# --- Stripe (subscriptions) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_CREATOR=price_xxx
STRIPE_PRICE_TEAM=price_xxx
STRIPE_PRICE_AGENCY=price_xxx

# --- Resend (transactional email) ---
RESEND_API_KEY=
EMAIL_FROM=alerts@cliplift.com

# --- Storage (Supabase Storage in prod, local disk in dev) ---
STORAGE_BACKEND=auto
SUPABASE_STORAGE_BUCKET=cliplift-videos
LOCAL_STORAGE_DIR=./uploads

# --- OAuth (Google — YouTube publishing) ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
OAUTH_REDIRECT_BASE_URL=http://localhost:8000/api/v1/connections
FRONTEND_URL=http://localhost:3000

# --- OAuth (Meta — Instagram publishing) ---
META_OAUTH_CLIENT_ID=
META_OAUTH_CLIENT_SECRET=

# --- Anthropic (AI content brief generation) ---
ANTHROPIC_API_KEY=

# --- Sentry (error monitoring) ---
SENTRY_DSN=

# --- Encryption (OAuth token storage) ---
# REQUIRED in production. Generate a fresh key:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# For local dev, this default works fine:
ENCRYPTION_KEY=zqZJ-oUXXSIzpYSCDLkOgU0ENN3v9XnD3O0K_p6Ip-A=

# ==============================================================================
# Frontend (Next.js)
# These must be prefixed with NEXT_PUBLIC_ to be exposed to the browser.
# ==============================================================================
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_URL=http://localhost:8000
